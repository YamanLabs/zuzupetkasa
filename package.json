{
  "name": "nextjs-kasa-pos",
  "version": "3.7.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"node gmp3-server.js\" \"next dev\"",
    "dev:custom": "node server.js",
    "gmp3:server": "node gmp3-server.js",
    "electron:dev": "concurrently -k \"node gmp3-server.js\" \"next dev\" \"npx wait-on http://localhost:3000 && electron .\"",
    "build": "next build",
    "electron:build": "next build && electron-builder",
    "dist": "next build && electron-builder --win portable --x64 --arm64",
    "dist:x64": "next build && electron-builder --win portable --x64",
    "dist:arm64": "next build && electron-builder --win portable --arm64",
    "dist:all": "next build && electron-builder --win portable --x64 --arm64",
    "dist:unpacked": "next build && electron-builder --dir",
    "dist:unpacked:arm64": "next build && electron-builder --dir --arm64",
    "start": "node server.js",
    "lint": "eslint"
  },
  "dependencies": {
    "@google/genai": "^2.13.0",
    "@phosphor-icons/react": "^2.1.10",
    "electron-serve": "^3.0.1",
    "framer-motion": "^12.42.2",
    "next": "16.2.11",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sql.js": "^1.4.11",
    "concurrently": "^10.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^7.2.0"
  }
}
