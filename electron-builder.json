{
  "appId": "com.yamanlabs.kasapos",
  "productName": "ZUZU PET Kasa Otomasyonu POS",
  "directories": {
    "output": "dist"
  },
  "files": [
    "electron/**/*",
    "out/**/*",
    "public/**/*",
    "gmp3-server.js",
    "package.json",
    "node_modules/sql.js/**/*",
    "node_modules/electron-serve/**/*",
    "node_modules/@google/genai/**/*",
    "node_modules/pdfjs-dist/**/*",
    "!node_modules/@next/**/*",
    "!node_modules/@img/**/*",
    "!node_modules/sharp/**/*",
    "!node_modules/@swc/**/*",
    "!node_modules/better-sqlite3/**/*",
    "!**/*.map",
    "!**/*.md",
    "!node_modules/.cache/**/*"
  ],
  "asar": true,
  "asarUnpack": [
    "node_modules/sql.js/dist/sql-wasm.wasm"
  ],
  "win": {
    "icon": "public/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64", "arm64"]
      }
    ],
    "requestedExecutionLevel": "asInvoker"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "ZUZU PET Kasa POS",
    "artifactName": "ZUZU_PET_Kasa_POS_Setup_${arch}.exe"
  },
  "mac": {
    "icon": "public/xuxu_logo.png",
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64", "universal"]
      }
    ]
  },
  "portable": {
    "artifactName": "ZUZU_PET_Kasa_POS_${arch}.exe"
  }
}
